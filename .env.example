# ============================================================================
# Eonora Tech OS - Environment Configuration
# Copy this file to .env and fill in your values.
#
# Load order (later files override earlier ones):
#   1. .env          — shared / committed defaults
#   2. .env.local    — machine-specific overrides (git-ignored)
# ============================================================================

# --- Environment ---
# Options: development, production, testing
FLASK_ENV=development
ENV=development

# --- Application ---
# APP_NAME=Eonora Tech OS
# DEBUG=False
# LOG_LEVEL=INFO          # DEBUG, INFO, WARNING, ERROR, CRITICAL
# STATIC_FOLDER=.dist

# --- Security ---
# IMPORTANT: Set a unique secret key for production!
# If not set, a machine-specific key is generated automatically (dev only).
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=

# Session duration in hours (default: 8)
SESSION_DURATION_HOURS=8

# Max login attempts before rate limiting (default: 10)
MAX_LOGIN_ATTEMPTS=10

# Rate limit window in seconds (default: 60)
RATE_LIMIT_WINDOW_SECONDS=60

# --- Database ---
# SQLite database URL. Default: ~/Desktop/Eonora Tech OS Database/marion.db
DATABASE_URL=

# Data path for file storage (default: ~/Desktop/Eonora Tech OS Database)
DATA_PATH=

# --- AI (Gemini) ---
# Required for Franck chatbot. Get your key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# --- Google OAuth ---
# Required for Google Calendar sync and Google Drive integration
# Create at: https://console.cloud.google.com/apis/credentials
# Test user required (Testing mode): marion.kindynis@gmail.com — see docs/GOOGLE_OAUTH_MARION.md
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:5003/api/v1/oauth/google/callback
GOOGLE_SCOPES=https://www.googleapis.com/auth/drive.file https://www.googleapis.com/auth/calendar

# --- GitHub (Auto-updates) ---
# Personal access token for checking updates from the GitHub repo
GITHUB_TOKEN=
GITHUB_REPO_OWNER=VilaJo
GITHUB_REPO_NAME=Marion-Web-OS-v2

# --- Email (IMAP / SMTP) ---
# IMAP settings for email client integration
IMAP_HOST=mail.infomaniak.com
IMAP_PORT=993

# SMTP settings for sending emails
SMTP_HOST=mail.infomaniak.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Eonora Tech OS

# --- CORS ---
# Comma-separated list of allowed origins
CORS_ORIGINS=http://127.0.0.1:5003,http://localhost:5003

# --- Server ---
HOST=127.0.0.1
PORT=5003
