#!/bin/bash

# Marion Web OS Launcher
# Replique le comportement de LANCER_MARION.command

# Setup PATH
export PATH="/usr/local/bin:/usr/bin:/bin:/opt/homebrew/bin:$PATH"

# Find the project directory
SCRIPT_PATH="$(cd "$(dirname "$0")" && pwd)"
APP_BUNDLE="$(dirname "$(dirname "$SCRIPT_PATH")")"
APP_PARENT="$(dirname "$APP_BUNDLE")"

PROJECT_DIR=""
POSSIBLE_PATHS=(
    "$APP_PARENT"
    "$HOME/Desktop/Marion-Web-OS-v2-main"
    "$HOME/Desktop/Marion Web OS"
    "$HOME/Desktop/Marion-Web-OS-v2"
    "$HOME/Downloads/Marion-Web-OS-v2-main"
)

for path in "${POSSIBLE_PATHS[@]}"; do
    if [ -f "$path/franck_server.py" ]; then
        PROJECT_DIR="$path"
        break
    fi
done

if [ -z "$PROJECT_DIR" ]; then
    osascript -e 'display alert "Marion Web OS" message "Dossier du projet introuvable." as critical'
    exit 1
fi

# If server is already running, just open browser
if lsof -i :5003 > /dev/null 2>&1; then
    open "http://127.0.0.1:5003"
    exit 0
fi

# Open Terminal and run the exact same logic as LANCER_MARION.command
osascript <<APPLESCRIPT
tell application "Terminal"
    activate
    do script "cd '$PROJECT_DIR' && clear && echo '🦄 Marion Web OS - Démarrage...' && echo '' && if [ -d '.venv' ]; then source .venv/bin/activate; fi && python3 franck_server.py &
SERVER_PID=\$!
echo \$SERVER_PID > .marion.pid
echo '⏳ Initialisation...'
for i in \$(seq 1 30); do
    if curl -s http://127.0.0.1:5003/api/version > /dev/null 2>&1; then
        echo '✅ Serveur prêt !'
        break
    fi
    sleep 1
done
echo '🌐 Ouverture du navigateur...'
open 'http://127.0.0.1:5003'
echo ''
echo '🦄 Marion Web OS est en cours!'
echo '   📍 URL: http://127.0.0.1:5003'
echo '   💡 Ferme cette fenêtre pour arrêter'
echo ''
wait \$SERVER_PID"
end tell
APPLESCRIPT

exit 0
