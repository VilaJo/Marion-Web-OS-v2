#!/bin/bash

# Marion Web OS Launcher
# This script starts the server and opens the browser

# Get the directory where the .app is located
APP_DIR="$(dirname "$(dirname "$(dirname "$0")")")"
# Go up one more level to get the project directory (parent of .app)
PROJECT_DIR="$(dirname "$APP_DIR")"

# If the app is inside the project folder, use that
if [ -f "$PROJECT_DIR/franck_server.py" ]; then
    cd "$PROJECT_DIR"
elif [ -f "$APP_DIR/../franck_server.py" ]; then
    cd "$APP_DIR/.."
else
    # Fallback: try common locations
    if [ -f "$HOME/Desktop/Marion-Web-OS-v2-main/franck_server.py" ]; then
        cd "$HOME/Desktop/Marion-Web-OS-v2-main"
    elif [ -f "$HOME/Desktop/Marion Web OS/franck_server.py" ]; then
        cd "$HOME/Desktop/Marion Web OS"
    else
        osascript -e 'display alert "Marion Web OS" message "Impossible de trouver le dossier du projet. Placez l'\''application dans le dossier Marion Web OS." as critical'
        exit 1
    fi
fi

# Check if server is already running
if lsof -i :5003 > /dev/null 2>&1; then
    echo "Server already running on port 5003"
else
    # Start the server in background
    echo "Starting Marion Web OS server..."
    
    # Try to find Python
    PYTHON_CMD=""
    if command -v python3 &> /dev/null; then
        PYTHON_CMD="python3"
    elif command -v python &> /dev/null; then
        PYTHON_CMD="python"
    else
        osascript -e 'display alert "Marion Web OS" message "Python n'\''est pas installé. Installez Python 3 pour utiliser Marion Web OS." as critical'
        exit 1
    fi
    
    # Start server in background and save PID
    nohup $PYTHON_CMD franck_server.py > /tmp/marion_server.log 2>&1 &
    SERVER_PID=$!
    echo $SERVER_PID > /tmp/marion_server.pid
    
    # Wait for server to be ready (max 10 seconds)
    echo "Waiting for server to start..."
    for i in {1..20}; do
        if curl -s http://127.0.0.1:5003 > /dev/null 2>&1; then
            echo "Server is ready!"
            break
        fi
        sleep 0.5
    done
    
    # Check if server actually started
    if ! lsof -i :5003 > /dev/null 2>&1; then
        osascript -e 'display alert "Marion Web OS" message "Le serveur n'\''a pas pu démarrer. Vérifiez les logs dans /tmp/marion_server.log" as critical'
        exit 1
    fi
fi

# Open browser
echo "Opening browser..."
open "http://127.0.0.1:5003"

exit 0
